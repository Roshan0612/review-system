# Optional: without these, the honest non-AI composer still works.
XAI_API_KEY=
# Set to a text model available in your xAI account.
XAI_MODEL=
# Required for AI in production: shared durable daily rate limits (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Replace with a random long secret; used to hash client identifiers.
RATE_LIMIT_SALT=
AI_DAILY_LIMIT=100
AI_PER_IP_DAILY_LIMIT=10
# Replace with the official Google Business Profile review-request URL when available.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://www.google.com/search?q=the+brand+store+virar#lrd=0x3be7ab002e92dcc7:0x6877ddd6e8acce91,3,,,,
